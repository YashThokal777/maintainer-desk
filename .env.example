# Copy to .env and fill in. Never commit .env or .desk-state*.json.

# The Switch API (not the Gateway). Local self-host: http://localhost:8000
SWITCH_API_URL=http://localhost:8000

# Only for `register`, once: Gateway (http://localhost:3000) > API Keys > Create.
# On a local server started by Switch Console, leave it empty: it is read from
# %APPDATA%/switchdash/local-switch-server/native/run/switch-core.env
# (that file's SERVER_PORT is also the port for SWITCH_API_URL).
SWITCH_REGISTRATION_KEY=

# The repository the desk looks after, as owner/name
DESK_REPO=your-github-user/tinystats

# Must match the "Desk name" you give the template (default: desk)
DESK_TEAM=desk

# Optional. Without it, the token `gh auth token` prints is used.
# GITHUB_TOKEN=

# Optional
# DESK_POLL_SECONDS=60
# DESK_AGENT_NAME=desk-watcher
# DESK_INTAKE_ROOM=desk-intake
# DESK_TRIAGER=desk-triager
# DESK_ANNOUNCE_EXISTING=false
